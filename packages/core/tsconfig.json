{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["vitest/globals", "node"],
    // Das Sync-Skript läuft ohne Build-Schritt über `node --experimental-strip-types`
    // und muss seine Importe deshalb mit `.ts` schreiben.
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.ts", "*.config.ts"]
}
